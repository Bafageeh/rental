{
  "name": "my-rentals-mobile",
  "main": "expo-router/entry",
  "version": "1.0.1",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:dev": "BROWSER=none EXPO_NO_TELEMETRY=1 REACT_NATIVE_PACKAGER_HOSTNAME=my.pm.sa expo start --web --host lan --port 8082",
    "web:build": "EXPO_NO_TELEMETRY=1 expo export --platform web",
    "web:deploy:rental": "bash scripts/deploy-web-rental.sh",
    "web:clear": "rm -rf .expo dist node_modules/.cache && mkdir -p /mnt/home-storage/home/pmsa/apps/.cache /mnt/home-storage/home/pmsa/apps/.tmp",
    "mobile:dev": "BROWSER=none EXPO_NO_TELEMETRY=1 REACT_NATIVE_PACKAGER_HOSTNAME=rental.pm.sa expo start --clear --go --host lan --port 8090",
    "lint": "expo lint",
    "start:safe": "mkdir -p /mnt/home-storage/home/pmsa/apps/.tmp && TMPDIR=/mnt/home-storage/home/pmsa/apps/.tmp TMP=/mnt/home-storage/home/pmsa/apps/.tmp TEMP=/mnt/home-storage/home/pmsa/apps/.tmp npx expo start --clear --go --host lan --port 8090",
    "start:tunnel": "mkdir -p /mnt/home-storage/home/pmsa/apps/.tmp && TMPDIR=/mnt/home-storage/home/pmsa/apps/.tmp TMP=/mnt/home-storage/home/pmsa/apps/.tmp TEMP=/mnt/home-storage/home/pmsa/apps/.tmp npx expo start --clear --tunnel"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.18",
    "expo-constants": "^57.0.0",
    "expo-dev-client": "^57.0.0",
    "expo-device": "^57.0.0",
    "expo-document-picker": "^57.0.0",
    "expo-font": "^57.0.0",
    "expo-glass-effect": "^57.0.0",
    "expo-image": "^57.0.0",
    "expo-linking": "^57.0.0",
    "expo-router": "^57.0.0",
    "expo-secure-store": "^57.0.0",
    "expo-splash-screen": "^57.0.0",
    "expo-status-bar": "^57.0.0",
    "expo-symbols": "^57.0.0",
    "expo-system-ui": "^57.0.0",
    "expo-updates": "^57.0.0",
    "expo-web-browser": "^57.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react-native-screens": "4.26.2"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "private": true
}
