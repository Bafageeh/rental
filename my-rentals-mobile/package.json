{
  "name": "my-rentals-mobile",
  "main": "expo-router/entry",
  "version": "1.0.1",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:dev": "BROWSER=none EXPO_NO_TELEMETRY=1 REACT_NATIVE_PACKAGER_HOSTNAME=my.pm.sa expo start --web --host lan --port 8082",
    "web:build": "EXPO_NO_TELEMETRY=1 expo export --platform web",
    "web:deploy:rental": "bash scripts/deploy-web-rental.sh",
    "web:clear": "rm -rf .expo dist node_modules/.cache && mkdir -p /mnt/home-storage/home/pmsa/apps/.cache /mnt/home-storage/home/pmsa/apps/.tmp",
    "mobile:dev": "BROWSER=none EXPO_NO_TELEMETRY=1 REACT_NATIVE_PACKAGER_HOSTNAME=rental.pm.sa expo start --clear --dev-client --host lan --port 8090",
    "lint": "expo lint",
    "start:safe": "mkdir -p /mnt/home-storage/home/pmsa/apps/.tmp && TMPDIR=/mnt/home-storage/home/pmsa/apps/.tmp TMP=/mnt/home-storage/home/pmsa/apps/.tmp TEMP=/mnt/home-storage/home/pmsa/apps/.tmp npx expo start --clear --dev-client --host lan --port 8090",
    "start:tunnel": "mkdir -p /mnt/home-storage/home/pmsa/apps/.tmp && TMPDIR=/mnt/home-storage/home/pmsa/apps/.tmp TMP=/mnt/home-storage/home/pmsa/apps/.tmp TEMP=/mnt/home-storage/home/pmsa/apps/.tmp npx expo start --clear --dev-client --tunnel"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "7.15.10",
    "@react-navigation/elements": "2.9.15",
    "@react-navigation/native": "7.2.2",
    "expo": "55.0.26",
    "expo-constants": "55.0.16",
    "expo-dev-client": "55.0.37",
    "expo-device": "55.0.17",
    "expo-document-picker": "55.0.13",
    "expo-font": "55.0.8",
    "expo-glass-effect": "55.0.11",
    "expo-image": "55.0.11",
    "expo-linking": "55.0.15",
    "expo-router": "55.0.16",
    "expo-secure-store": "55.0.14",
    "expo-splash-screen": "55.0.21",
    "expo-status-bar": "55.0.6",
    "expo-symbols": "55.0.9",
    "expo-system-ui": "55.0.18",
    "expo-updates": "55.0.26",
    "expo-web-browser": "55.0.16",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.23.0",
    "react-native-web": "0.21.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "19.2.2",
    "typescript": "5.9.2"
  },
  "private": true
}
